#include <dt-bindings/clock/mdss-5nm-pll-clk.h>
#include <dt-bindings/clock/qcom,dispcc-yupik.h>
#include "dsi-panel-nothing-m20-36-02-0a-dsc-vid.dtsi"
#include "dsi-panel-nothing-m20-42-0d-0b-dsc-vid.dtsi"
#include "dsi-panel-nothing-visionox-rm692e5-1080x2400-120hz-cmd-common.dtsi"


&sde_dp {
	status = "disabled";
};

&qcom_msmhdcp {
	status = "disabled";
};

&mdss_mdp {
	connectors = <&smmu_sde_unsec &smmu_sde_sec &sde_wb &sde_dsi &sde_rscc>;
};

&sde_dsi {
	/* AMOLED panel is supplied directly from PMR735A (L12C / L13C);
	 */
	vddio-supply = <&L12C>;
	vdd-supply = <&L13C>;
	/delete-property/ lab-supply;
	/delete-property/ ibb-supply;

	pinctrl-names = "panel_active", "panel_suspend";
	pinctrl-0 = <&sde_dsi_active &sde_te_active>;
	pinctrl-1 = <&sde_dsi_suspend &sde_te_suspend>;
	qcom,platform-te-gpio = <&tlmm 80 0>;
	qcom,panel-te-source = <0>;

	qcom,dsi-default-panel = <&dsi_nothing_rm692e5_visionox_120hz_cmd>;
};