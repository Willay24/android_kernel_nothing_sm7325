#include <dt-bindings/thermal/thermal_qti.h>

&battery_charger {
	qcom,thermal-mitigation = <4000000 3800000 3600000 3400000 3200000
				3000000 2800000 2600000 2400000 2200000
				2000000 1800000 1600000 1400000 1200000
				1000000 900000 800000 700000 600000
				500000 400000 300000 200000 0>;
	qcom,wireless-charging-supported;

	/* JEITA: 9 bands, temps in 0.1 C, FCC in uA.
	 * Bands: <0, 0-10, 10-15, 15-35, 35-40, 40-45, 45-50, 50-55, >=55 C.
	 * Max caps stay under the 4 A firmware ceiling so they always apply;
	 * values >= fcc_max_ua would be treated as "no cap" by the driver.
	 * std covers SDP/DCP/wireless, qc HVDCP, pd PD/PPS. */
	nt,jeita-poll-ms = <5000>;
	nt,jeita-hyst-decidegc = <20>;
	nt,jeita-temp-decidegc = <0 100 150 350 400 450 500 550>;
	nt,jeita-fcc-std-ua = <0 500000 1000000 2000000 2000000 1500000 1000000 500000 0>;
	nt,jeita-fcc-qc-ua  = <0 500000 1500000 3000000 2500000 2000000 1000000 500000 0>;
	nt,jeita-fcc-pd-ua  = <0 1000000 2000000 3500000 3000000 2500000 1500000 500000 0>;

	/* Below 15 C battery temp the skin-sensor thermal ladder is not
	 * enforced (Xiaomi-style); JEITA still caps the cold bands. */
	nt,thermal-ladder-min-temp-decidegc = <150>;
};

&thermal_zones {
	/* quiet-therm skin sensor -> charger, remapped to the fine ladder */
	quiet-therm-nt-step {
		cooling-maps {
			batt-cdev0 {
				trip = <&quiet_batt_trip0>;
				cooling-device = <&battery_charger 3 3>;
			};

			batt-cdev1 {
				trip = <&quiet_batt_trip1>;
				cooling-device = <&battery_charger 6 6>;
			};

			batt-cdev2 {
				trip = <&quiet_batt_trip2>;
				cooling-device = <&battery_charger 9 9>;
			};

			batt-cdev3 {
				trip = <&quiet_batt_trip3>;
				cooling-device = <&battery_charger 12 12>;
			};

			batt-cdev4 {
				trip = <&quiet_batt_trip4>;
				cooling-device = <&battery_charger 16 16>;
			};
		};
	};

	chg_skin_therm {
		polling-delay-passive = <1000>;
		polling-delay = <0>;
		thermal-governor = "step_wise";

		trips {
			charger_skin_trip0: charger-skin-trip0 {
				temperature = <40000>;
				hysteresis = <2000>;
				type = "passive";
			};

			charger_skin_trip1: charger-skin-trip1 {
				temperature = <44000>;
				hysteresis = <2000>;
				type = "passive";
			};

			charger_skin_trip2: charger-skin-trip2 {
				temperature = <48000>;
				hysteresis = <2000>;
				type = "passive";
			};
		};

		cooling-maps {
			/* mild: FCC 3.4 A */
			charger_batt_cdev0 {
				trip = <&charger_skin_trip0>;
				cooling-device = <&battery_charger 4 4>;
			};

			/* medium: FCC 2.6 A + slight GPU limit */
			charger_batt_cdev1 {
				trip = <&charger_skin_trip1>;
				cooling-device = <&battery_charger 8 8>;
			};

			charger_gpu_cdev {
				trip = <&charger_skin_trip1>;
				cooling-device = <&msm_gpu (THERMAL_MAX_LIMIT-2)
							(THERMAL_MAX_LIMIT-2)>;
			};

			/* hot: FCC 1.4 A, silver cluster capped */
			charger_batt_cdev2 {
				trip = <&charger_skin_trip2>;
				cooling-device = <&battery_charger 14 14>;
			};

			charger_silver_cdev {
				trip = <&charger_skin_trip2>;
				cooling-device = <&CPU0 THERMAL_NO_LIMIT
						(THERMAL_MAX_LIMIT-6)>;
			};
		};
	};

	quiet_therm {
		polling-delay-passive = <1000>;
	};

	batt_therm {
		polling-delay-passive = <2000>;
	};
};