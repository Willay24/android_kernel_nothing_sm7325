// nothing-spacewar-sm7325.dtsi
// This file is for Nothing Phone (1) "spacewar" (SM7325 "Yupik") only.
//
// Inherited unmodified from yupik-qrd.dtsi -> yupik.dtsi, no overrides needed:
//   - Modem PIL       : pil_modem / qcom,mss@4080000
//   - CDSP PIL        : qcom,turing@a300000
//   - IPA / data path : ipa_hw / qcom,ipa@1e00000
//   - Charging/USB-PD : qcom,pmic_glink (battery_charger, ucsi, altmode)
//   - PM7325 regulators (incl. L3C/L8C/L12C/L13C used below)
//   - Video (Venus)   : msm_vidc

#include "yupik-abra-common-overlay.dtsi"
#include "nothing-spacewar-pinctrl.dtsi"
#include "nothing-spacewar-audio-overlay.dtsi"

/* device-specific states here. */
&pm8350c_flash {
	status = "ok";
};

&pm8350b_haptics {
	status = "ok";
	qcom,Vrms_mv = <1270>;
	qcom,vmax-mv = <9150>;
	qcom,lra-period-us = <5880>;
	qcom,brake-mode = <1>;
	qcom,brake-pattern = /bits/ 8 <0xff 0x3f 0x1f>;
	qcom,drv-sig-shape = <1>;
	qcom,brake-sig-shape = <1>;

	effect_0 {
		qcom,effect-id = <0>;
		qcom,wf-vmax-mv = <3600>;
		qcom,wf-pattern-data = <0x01f 0x0 0x0>,
					<0x03f 0x0 0x0>,
					<0x05f 0x0 0x0>,
					<0x07f 0x0 0x0>,
					<0x17f 0x0 0x0>,
					<0x15f 0x0 0x0>,
					<0x13f 0x0 0x0>,
					<0x11f 0x0 0x0>;
		qcom,wf-pattern-period-us = <5880>;
		qcom,wf-brake-pattern = /bits/ 8 <0x00 0x00 0x00>;
		qcom,wf-pattern-preload;
		qcom,wf-auto-res-disable;
	};

	effect_1 {
		qcom,effect-id = <1>;
		qcom,wf-vmax-mv = <3600>;
		qcom,wf-pattern-data = <0x01f 0x0 0x0>,
					<0x03f 0x0 0x0>,
					<0x05f 0x0 0x0>,
					<0x07f 0x0 0x0>,
					<0x17f 0x0 0x0>,
					<0x15f 0x0 0x0>,
					<0x13f 0x0 0x0>,
					<0x11f 0x0 0x0>;
		qcom,wf-pattern-period-us = <5880>;
		qcom,wf-brake-pattern = /bits/ 8 <0x00 0x00 0x00>;
		qcom,wf-auto-res-disable;
	};

	effect_2 {
		qcom,effect-id = <2>;
		qcom,wf-vmax-mv = <3600>;
		qcom,wf-pattern-data = <0x01f 0x0 0x0>,
					<0x03f 0x0 0x0>,
					<0x05f 0x0 0x0>,
					<0x07f 0x0 0x0>,
					<0x17f 0x0 0x0>,
					<0x15f 0x0 0x0>,
					<0x13f 0x0 0x0>,
					<0x11f 0x0 0x0>;
		qcom,wf-pattern-period-us = <5880>;
		qcom,wf-brake-pattern = /bits/ 8 <0x00 0x00 0x00>;
		qcom,wf-auto-res-disable;
	};

	effect_3 {
		qcom,effect-id = <3>;
		qcom,wf-vmax-mv = <3600>;
		qcom,wf-pattern-data = <0x01f 0x0 0x0>,
					<0x03f 0x0 0x0>,
					<0x05f 0x0 0x0>,
					<0x07f 0x0 0x0>,
					<0x17f 0x0 0x0>,
					<0x15f 0x0 0x0>,
					<0x13f 0x0 0x0>,
					<0x11f 0x0 0x0>;
		qcom,wf-pattern-period-us = <5880>;
		qcom,wf-brake-pattern = /bits/ 8 <0x00 0x00 0x00>;
		qcom,wf-auto-res-disable;
	};

	effect_4 {
		qcom,effect-id = <4>;
		qcom,wf-vmax-mv = <3600>;
		qcom,wf-pattern-data = <0x01f 0x0 0x0>,
					<0x03f 0x0 0x0>,
					<0x05f 0x0 0x0>,
					<0x07f 0x0 0x0>,
					<0x17f 0x0 0x0>,
					<0x15f 0x0 0x0>,
					<0x13f 0x0 0x0>,
					<0x11f 0x0 0x0>;
		qcom,wf-pattern-period-us = <5880>;
		qcom,wf-brake-pattern = /bits/ 8 <0x00 0x00 0x00>;
		qcom,wf-auto-res-disable;
	};

	effect_5 {
		qcom,effect-id = <5>;
		qcom,wf-vmax-mv = <3600>;
		qcom,wf-pattern-data = <0x01f 0x0 0x0>,
					<0x03f 0x0 0x0>,
					<0x05f 0x0 0x0>,
					<0x07f 0x0 0x0>,
					<0x17f 0x0 0x0>,
					<0x15f 0x0 0x0>,
					<0x13f 0x0 0x0>,
					<0x11f 0x0 0x0>;
		qcom,wf-pattern-period-us = <5880>;
		qcom,wf-brake-pattern = /bits/ 8 <0x00 0x00 0x00>;
		qcom,wf-auto-res-disable;
	};

	effect_7 {
		qcom,effect-id = <7>;
		qcom,wf-vmax-mv = <3600>;
		qcom,wf-fifo-data = /bits/ 8 <0x00 0x00 0x01 0x02 0x04 0x08 0x0e 0x18 0x2a 0x47
				0x60 0x6d 0x75 0x79 0x7c 0x7d 0x7e 0x7d 0x7d 0x7b
				0x77 0x71 0x66 0x53 0x33 0xfb 0xc7 0xa9 0x98 0x8e
				0x88 0x85 0x83 0x82 0x81 0x81 0x81 0x82 0x83 0x84
				0x87 0x8d 0x96 0xa6 0xc1 0xf2 0x22 0x36 0x35 0x1b
				0xe8 0xbb 0xa3 0x94 0x8c 0x87 0x84 0x82 0x82 0x81
				0x81 0x81 0x81 0x81 0x81 0x82 0x83 0x85 0x88 0x8e
				0x97 0xa8 0xc5 0xf8 0x2e 0x4c 0x5e 0x67 0x6a 0x69
				0x62 0x53 0x39 0x21 0x13 0x0b 0x06 0x03 0x02 0x01
				0x00>;
		qcom,wf-fifo-period = <8>;
		qcom,wf-brake-disable;
		qcom,wf-auto-res-disable;
		qcom,wf-pattern-period-us = <5880>;
	};
};

&qupv3_se1_i2c {
	status = "ok";
};

&qupv3_se9_i2c {
	status = "ok";
};

&st21nfc {
	status = "disabled";
};

&qupv3_se14_spi {
	status = "ok";
};

&icnss2 {
	use-nv-mac;
};

&sdhc_2 {
	status = "disabled";
};

/* and power tables remain in the shared Yupik display sources. */
&sde_dsi {
	vddio-supply = <&L12C>;
	vdd-supply = <&L13C>;
	/delete-property/ lab-supply;
	/delete-property/ ibb-supply;
	qcom,dsi-default-panel = <&dsi_rm692e5_visionox_amoled_120hz_cmd>;
	qcom,dsi-dummy-panel = <&dsi_r66451_amoled_144hz_video_cphy>;
};

&qupv3_se13_spi {
	status = "ok";
	qcom,rt;
	#address-cells = <1>;
	#size-cells = <0>;

	goodix-berlin@0 {
		compatible = "goodix,gt9916S", "goodix,brl-d";
		reg = <0>;
		spi-max-frequency = <1000000>;

		goodix,avdd-name = "avdd";
		avdd-supply = <&L3C>;
		goodix,iovdd-name = "iovdd";
		iovdd-supply = <&L8C>;

		goodix,reset-gpio = <&tlmm 105 0x00>;
		goodix,irq-gpio = <&tlmm 81 0x2800>;
		goodix,irq-flags = <2>;
		goodix,panel-max-x = <1080>;
		goodix,panel-max-y = <2400>;
		goodix,panel-max-w = <255>;
		goodix,panel-max-p = <4096>;
		goodix,pen-enable;
		goodix,firmware-name = "goodix_firmware.bin";
		goodix,config-name = "goodix_cfg_group.bin";
	};
};

&soc {
	nt-thermal-interface {
		board-sensor = "spacewar-board-sensor";
		qcom,display-panels = <&dsi_rm692e5_visionox_amoled_120hz_cmd
					&dsi_r66451_amoled_144hz_video_cphy>;
	};
};