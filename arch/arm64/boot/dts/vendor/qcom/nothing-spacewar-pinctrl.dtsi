&tlmm {
	qcom,gpios-reserved = <32 33 48 51>;

	qupv3_se13_spi_sleep_nt: qupv3_se13_spi_sleep_nt {
		mux {
			pins = "gpio52", "gpio53", "gpio54";
			function = "gpio";
		};
		config {
			pins = "gpio52", "gpio53", "gpio54";
			drive-strength = <2>;
			bias-pull-down;
		};
	};

	qupv3_se13_spi_sleep_cs: qupv3_se13_spi_sleep_cs {
		mux {
			pins = "gpio55";
			function = "gpio";
		};
		config {
			pins = "gpio55";
			drive-strength = <2>;
			bias-pull-up;
			output-high;
		};
	};
};
