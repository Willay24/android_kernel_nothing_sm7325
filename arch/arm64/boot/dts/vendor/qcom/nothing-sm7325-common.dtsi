/* Nothing Phone (1) - SM7325 common board configuration */

&spmi_debug_bus   { status = "disabled"; };
&spmi_glink_debug { status = "disabled"; };

/* PM8008 camera PMICs not fitted */
&pm8008i_chip { status = "disabled"; };
&pm8008i_ldo  { status = "disabled"; };
&pm8008j_chip { status = "disabled"; };
&pm8008j_ldo  { status = "disabled"; };

/* PMR735A not answering, disable it and its ldoe2..6 rails */
&pmr735a_spmi { status = "disabled"; };

&pmr735a_temp_alarm {
	disable-thermal-zone;
	status = "disabled";
};

&apps_rsc {
	rpmh-regulator-ldoe2 { status = "disabled"; };
	rpmh-regulator-ldoe3 { status = "disabled"; };
	rpmh-regulator-ldoe4 { status = "disabled"; };
	rpmh-regulator-ldoe5 { status = "disabled"; };
	rpmh-regulator-ldoe6 { status = "disabled"; };
};

/* UFS only, no eMMC */
&sdhc_1 { status = "disabled"; };

&ufsphy_mem {
	compatible = "qcom,ufs-phy-qmp-v4-yupik";

	vdda-phy-supply = <&L10C>;
	vdda-pll-supply = <&L6B>;
	vdda-phy-max-microamp = <97500>;
	vdda-pll-max-microamp = <18400>;

	status = "okay";
};

&ufshc_mem {
	vdd-hba-supply = <&gcc_ufs_phy_gdsc>;
	vdd-hba-fixed-regulator;

	vcc-supply = <&L7B>;
	vcc-voltage-level = <2952000 2952000>;
	vcc-low-voltage-sup;
	vcc-max-microamp = <800000>;

	/* L9B also gates the eLDO for VCCQ2 (UFS 2.2), keep vccq */
	vccq-supply = <&L9B>;
	vccq-max-microamp = <900000>;
	vccq-min-microamp = <10000>;

	qcom,vddp-ref-clk-supply = <&L9B>;
	qcom,vddp-ref-clk-max-microamp = <100>;

	status = "okay";
};
