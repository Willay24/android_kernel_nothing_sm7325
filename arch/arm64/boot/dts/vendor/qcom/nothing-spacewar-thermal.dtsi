#include <dt-bindings/thermal/thermal_qti.h>

&thermal_zones {
	/* Silver CPU0 (tsens0 1) */
	cpu-silver-0-step {
		polling-delay-passive = <20>;
		polling-delay = <0>;
		thermal-sensors = <&tsens0 1>;
		thermal-governor = "step_wise";
		trips {
			cs0_config: cs0-config {
				temperature = <85000>;
				hysteresis = <3000>;
				type = "passive";
			};
			cs0_config1: cs0-config1 {
				temperature = <98000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};
		cooling-maps {
			cs0_cdev {
				trip = <&cs0_config>;
				cooling-device = <&CPU0 THERMAL_NO_LIMIT
						(THERMAL_MAX_LIMIT - 10)>;
			};
			cs0_cdev1 {
				trip = <&cs0_config1>;
				cooling-device = <&CPU0 (THERMAL_MAX_LIMIT - 10)
						THERMAL_MAX_LIMIT>;
			};
		};
	};

	/* Silver CPU1 (tsens0 2) */
	cpu-silver-1-step {
		polling-delay-passive = <20>;
		polling-delay = <0>;
		thermal-sensors = <&tsens0 2>;
