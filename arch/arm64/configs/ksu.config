# Nothing build config
#
CONFIG_NOTHING=y
CONFIG_NOTHING_SPACEWAR=y

# GMS Override
CONFIG_UNAME_SPOOF=y
CONFIG_FAKE_UNAME_5_10=y
CONFIG_UNAME_SPOOF_RELEASE="5.4.274-qgki-g4670d6bdb795"
CONFIG_UNAME_SPOOF_VERSION="#1 SMP PREEMPT Wed Jan 8 12:47:14 UTC 2025"

# TMPFS Support
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

#
# KernelSU
#
CONFIG_KSU=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_HACK_ARM64_BRANCH_LINK=y
# CONFIG_KSU_TAMPER_SYSCALL_TABLE is not set
# CONFIG_KSU_DISABLE_32BIT_HOOKS is not set
CONFIG_KSU_LSM_SECURITY_HOOKS=y
# CONFIG_KSU_FEATURE_SULOG is not set
# CONFIG_KSU_FEATURE_ADBROOT is not set
CONFIG_KSU_HOSTSREDIRECT=y
# CONFIG_KSU_ENABLE_FULL_UID_CHECKS is not set
CONFIG_KSU_THRONE_TRACKER_ALWAYS_THREADED=y
# CONFIG_KSU_NOPRINTK is not set
CONFIG_KSU_SHELL_HAS_SU_ALWAYS=y
# CONFIG_KSU_DEBUG is not set
CONFIG_KSU_HEURISTIC_IN_TREE_BUILD=y

CONFIG_NOMOUNT=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_LOAD=y
# CONFIG_MODULE_FORCE_UNLOAD is not set
CONFIG_MODVERSIONS=n
# CONFIG_MODULE_SRCVERSION_ALL is not set
# CONFIG_MODULE_SIG is not set
CONFIG_ARM64_LSE_ATOMICS=y
# CONFIG_KALLSYMS_ALL is not set
