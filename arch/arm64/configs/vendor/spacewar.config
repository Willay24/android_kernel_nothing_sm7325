# Spacewar build config
CONFIG_NOTHING=y
CONFIG_NOTHING_SPACEWAR=y

# Glyph LEDs
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_AW210XX=y

# Audio
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_AUDIO_QGKI=y
CONFIG_SND_USB_AUDIO_QMI=y

# Touchscreen
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_NT36XXX=y
CONFIG_NOVATEK_TRUSTED_TOUCH=y

# Fingerprint
CONFIG_GOODIX_FINGERPRINT=y
