# Spacewar build config
CONFIG_NOTHING=y
CONFIG_NOTHING_SPACEWAR=y
CONFIG_ARCH_YUPIK=y
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# Modem and networking
CONFIG_QRTR=y
CONFIG_QRTR_NODE_ID=1
CONFIG_QRTR_WAKEUP_MS=0
CONFIG_QRTR_SMD=y
CONFIG_QRTR_MHI=y
CONFIG_QRTR_HAVEN=y
CONFIG_CNSS2=y
CONFIG_CNSS2_QMI=y
CONFIG_CNSS_ASYNC=y
CONFIG_IPA3=y

# USB and PMIC support
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_HAPS=y
CONFIG_USB_DWC3_OF_SIMPLE=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_DWC3_MSM=y
CONFIG_USB_MSM_SSPHY_QMP=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y

# Battery
CONFIG_QTI_BATTERY_CHARGER=y
CONFIG_QTI_BATTERY_GLINK_DEBUG=y

# Display and panel
CONFIG_DRM=y
CONFIG_MSM_EXT_DISPLAY=y

# PM8350B internal haptic actuator
CONFIG_INPUT_QCOM_HV_HAPTICS=y

# Glyph LEDs
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_AW210XX=y

# Audio
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_AUDIO_QGKI=y
CONFIG_SND_USB_AUDIO_QMI=y
CONFIG_SND_SOC_TFA98XX=y

# Touchscreen
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX_BRL=y
CONFIG_TOUCHSCREEN_GOODIX_BRL_SPI=y
CONFIG_NOTHING_TOUCH=y
CONFIG_TOUCHSCREEN_NT36XXX=y
CONFIG_NOVATEK_TRUSTED_TOUCH=y

# Camera
CONFIG_QCOM_CAMERA=y
CONFIG_MSM_CAMERA=y

# Fingerprint
CONFIG_GOODIX_FINGERPRINT=y
