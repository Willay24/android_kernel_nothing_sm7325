# Spacewar build config
CONFIG_NOTHING=y
CONFIG_NOTHING_SPACEWAR=y
CONFIG_ARCH_YUPIK=y
CONFIG_BUILD_ARM64_DT_OVERLAY=y
CONFIG_NOTHING_THERMAL_INTERFACE=y
CONFIG_NT_HWID=y
CONFIG_NT_SECURE_STATE=y
CONFIG_NT_SLOT_STATE=y
CONFIG_LEDS_AW210XX=y
CONFIG_NFC_QTI_I2C=y


# Battery
CONFIG_STWLC38_FW=y
CONFIG_QTI_BATTERY_CHARGER=y

# PM8350B internal haptic actuator
CONFIG_INPUT_QCOM_HV_HAPTICS=y


# Audio
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_AUDIO_QGKI=y
CONFIG_SND_USB_AUDIO_QMI=y

# Touchscreen
CONFIG_TOUCHSCREEN_NOTHING_TOUCHFEATURE=y
# CONFIG_TOUCHSCREEN_FTS is not set

# Fingerprint
CONFIG_GOODIX_FINGERPRINT=y

