# Spacewar build config
CONFIG_NOTHING=y
CONFIG_NOTHING_SPACEWAR=y
CONFIG_ARCH_YUPIK=y
CONFIG_BUILD_ARM64_DT_OVERLAY=y
CONFIG_NT_HWID=y
CONFIG_NT_SECURE_STATE=y
CONFIG_NT_SLOT_STATE=y
CONFIG_LEDS_AW210XX=y
CONFIG_NFC_QTI_I2C=y

# Nothing drivers
CONFIG_NOTHING_BOOTLOADER_LOG=y
CONFIG_NOTHING_WRITRBACK_KMSG=y
CONFIG_NOTHING_TASK_MEMINFO=y
CONFIG_NOTHING_SIMULATED_NTC=y
CONFIG_TOUCHSCREEN_NOTHING_TOUCHFEATURE=y

# Wifi
CONFIG_QCA_CLD_WLAN=y
CONFIG_CNSS_QCA6750=y
CONFIG_QCA_CLD_WLAN_PROFILE="qca6750"
CONFIG_QCA_CLD_WLAN_DYNAMIC_SINGLE_CHIP_NAME="qca6750"

# Battery
CONFIG_STWLC38_FW=y
CONFIG_QTI_BATTERY_CHARGER=y

# PM8350B internal haptic actuator
CONFIG_INPUT_QCOM_HV_HAPTICS=y

# Fingerprint
CONFIG_GOODIX_FINGERPRINT=y

